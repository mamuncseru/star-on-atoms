# House figure style for STAR on Atoms.
#
# Taken from the sister volumes' figure style so the series shares one
# surface, one type scale and one validated colour cycle.
#
# One deliberate difference: the cycle below leads with the quantum blue,
# because in this book the quantum code is the subject and the classical
# slate is the reference drawn against it. See book/styles/palette.py for
# which hue carries which role.

figure.facecolor: fcfcfb
axes.facecolor: fcfcfb
savefig.facecolor: fcfcfb

text.color: 0b0b0b
axes.titlecolor: 0b0b0b
axes.labelcolor: 52514e
xtick.labelcolor: 52514e
ytick.labelcolor: 52514e
xtick.color: 898781
ytick.color: 898781

axes.edgecolor: c3c2b7
axes.linewidth: 1.0
axes.spines.top: False
axes.spines.right: False

axes.grid: True
axes.grid.axis: y
grid.color: e1e0d9
grid.linewidth: 0.8
axes.axisbelow: True

# Categorical series order is a colorblind-safety mechanism — do not reorder.
axes.prop_cycle: cycler('color', ['2a78d6', '52514e', 'eda100', 'e34948', '1baf7a', 'eb6834', '4a3aa7', 'e87ba4'])

font.family: sans-serif
font.size: 11
axes.titlesize: 12
axes.titleweight: semibold
axes.labelsize: 11
xtick.labelsize: 10
ytick.labelsize: 10
legend.fontsize: 10
legend.frameon: False

lines.linewidth: 2
lines.markersize: 7

figure.dpi: 150
savefig.dpi: 300
savefig.bbox: tight
figure.constrained_layout.use: True
